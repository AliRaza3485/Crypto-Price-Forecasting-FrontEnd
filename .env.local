# Base URL of the FastAPI MLOps backend (no trailing slash).
# SERVER-ONLY — deliberately has no NEXT_PUBLIC_ prefix so the raw EC2 IP
# never reaches the browser bundle. All app/api/* route handlers read this
# on the server and proxy requests to it.
#
# Copy this file to .env.local and set your own value:
#   cp .env.example .env.local
BACKEND_URL=http://35.154.66.239:8000
